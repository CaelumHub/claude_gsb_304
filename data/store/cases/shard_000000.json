  {
    "id": "case_1791298319311_638fc4",
    "project_id": "proj_1791298319304_0e434a",
    "name": "健康检查接口",
    "description": "演示用例",
    "priority": "P0",
    "tags": [
      "smoke",
      "api"
    ],
    "timeout": 60,
    "enabled": true,
    "steps": [
      {
        "action": "request",
        "method": "GET",
        "url": "/api/health",
        "name": "请求健康检查"
      },
      {
        "action": "assert",
        "type": "status",
        "actual": "${resp.status}",
        "expected": 200,
        "name": "状态码 200"
      },
      {
        "action": "assert",
        "type": "truthy",
        "actual": "${resp.body.ok}",
        "expected": true,
        "name": "返回 ok"
      }
    ],
    "created_at": 1791298319.3116422
  },
