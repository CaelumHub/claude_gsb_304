  {
    "id": "case_1791298319323_15490a",
    "project_id": "proj_1791298319304_0e434a",
    "name": "字符串断言",
    "description": "演示用例",
    "priority": "P2",
    "tags": [
      "unit"
    ],
    "timeout": 60,
    "enabled": true,
    "steps": [
      {
        "action": "script",
        "expr": "2 + 3 * 4",
        "save_as": "result",
        "name": "算术"
      },
      {
        "action": "assert",
        "type": "equals",
        "actual": "${result}",
        "expected": 14,
        "name": "结果等于 14"
      },
      {
        "action": "assert",
        "type": "between",
        "actual": "${result}",
        "expected": [
          10,
          20
        ],
        "name": "结果在 10~20"
      }
    ],
    "created_at": 1791298319.3233252
  },
  {
    "id": "case_1791298319325_1ca4c8",
